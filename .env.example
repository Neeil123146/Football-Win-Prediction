# ==============================================================================
# Football Win Prediction System - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values as needed.
# Note: .env is ignored by version control to safeguard secrets.

# ------------------------------------------------------------------------------
# Flask Web Application Configuration
# ------------------------------------------------------------------------------
# In production, ensure FLASK_DEBUG is False (0).
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# External Live Data Providers
# ------------------------------------------------------------------------------
# Primary Provider: football-data.co.uk (Requires ZERO authentication / API key)
#
# Optional Secondary Provider: football-data.org (REST API v4)
# Free tier registration: https://www.football-data.org/client/register
# Leave blank to rely exclusively on the zero-auth football-data.co.uk feed.
FOOTBALL_DATA_API_KEY=
